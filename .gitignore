# Godot cache
/game/.godot/

# Local output: test captures and exported builds
/captures/
/export/

# Personal notes, never published: specs and the generated move and ability lists
/spec/
/docs/moves_by_type.md
/docs/abilities_by_effect.md
/private/

# Python
__pycache__/

# Music: arrangements by The Noble Demon, used with credit but never reuploaded on their
# own. Each copy of the project gets the files locally (see game/music/README.md); the
# released build carries them inside its .pck only.
/game/music/*
!/game/music/README.md
