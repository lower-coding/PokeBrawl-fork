; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokeBrawl"
config/version="demo-sylveon"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[input_devices]

buffering/agile_event_flushing=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/translations.en.translation", "res://i18n/translations.es.translation")

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
textures/decals/filter=2
anti_aliasing/quality/screen_space_aa=1
